from pathlib import Path

# Smart Rehabilitation Monitor
# This Python file contains the complete HTML + CSS + JavaScript.
# Run this file once to create index.html.
# Upload the generated index.html to GitHub Pages.

website = '<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="UTF-8">\n<meta name="viewport" content="width=device-width, initial-scale=1.0">\n<title>Smart Rehabilitation Monitor</title>\n\n<style>\n* {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n    font-family: Arial, sans-serif;\n}\n\nbody {\n    background: #f4f7fb;\n    color: #1f2937;\n}\n\nheader {\n    background: #12355b;\n    color: white;\n    padding: 22px 5%;\n}\n\nheader h1 {\n    font-size: 28px;\n}\n\nheader p {\n    margin-top: 6px;\n    opacity: 0.85;\n}\n\n.container {\n    width: 90%;\n    max-width: 1200px;\n    margin: 25px auto;\n}\n\n.patient-card,\n.card {\n    background: white;\n    border-radius: 14px;\n    padding: 22px;\n    margin-bottom: 20px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.08);\n}\n\n.patient-card {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 20px;\n}\n\n.status {\n    padding: 9px 15px;\n    border-radius: 20px;\n    background: #d1fae5;\n    color: #065f46;\n    font-weight: bold;\n}\n\n.grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 18px;\n}\n\n.monitor-card {\n    background: white;\n    border-radius: 14px;\n    padding: 22px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.08);\n}\n\n.monitor-card h3 {\n    color: #64748b;\n    font-size: 15px;\n    margin-bottom: 12px;\n}\n\n.value {\n    font-size: 34px;\n    font-weight: bold;\n}\n\n.good {\n    color: #16a34a;\n}\n\n.fair {\n    color: #d97706;\n}\n\n.poor {\n    color: #dc2626;\n}\n\n.exercise-title {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 18px;\n}\n\n.progress {\n    width: 100%;\n    height: 14px;\n    background: #e5e7eb;\n    border-radius: 20px;\n    overflow: hidden;\n}\n\n.progress-bar {\n    height: 100%;\n    width: 80%;\n    background: #2563eb;\n    transition: width 0.4s;\n}\n\n.rep-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 15px;\n    margin-top: 20px;\n}\n\n.rep {\n    padding: 15px;\n    border-radius: 10px;\n    background: #f8fafc;\n    text-align: center;\n}\n\n.rep strong {\n    display: block;\n    font-size: 24px;\n    margin-top: 5px;\n}\n\n.sensor-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 18px;\n}\n\n.sensor {\n    border: 1px solid #e5e7eb;\n    border-radius: 12px;\n    padding: 18px;\n}\n\n.sensor h3 {\n    margin-bottom: 8px;\n}\n\n.online {\n    color: #16a34a;\n    font-weight: bold;\n}\n\n.workflow {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 10px;\n    flex-wrap: wrap;\n    margin-top: 15px;\n}\n\n.step {\n    flex: 1;\n    min-width: 150px;\n    text-align: center;\n    padding: 18px;\n    background: #eff6ff;\n    border-radius: 12px;\n    font-weight: bold;\n}\n\n.arrow {\n    font-size: 24px;\n}\n\nbutton {\n    border: none;\n    background: #2563eb;\n    color: white;\n    padding: 12px 18px;\n    border-radius: 8px;\n    cursor: pointer;\n    font-weight: bold;\n}\n\nbutton:hover {\n    background: #1d4ed8;\n}\n\n.alert-item {\n    margin-top: 12px;\n    padding: 15px;\n    border-radius: 10px;\n    display: flex;\n    justify-content: space-between;\n    gap: 15px;\n}\n\n.alert-item.high {\n    background: #fee2e2;\n    border-left: 5px solid #dc2626;\n}\n\n.alert-item.low {\n    background: #dcfce7;\n    border-left: 5px solid #16a34a;\n}\n\n.alert-item p {\n    margin-top: 5px;\n}\n\n.notification-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 13px 0;\n    border-bottom: 1px solid #e5e7eb;\n}\n\n.switch {\n    width: 48px;\n    height: 25px;\n    position: relative;\n}\n\n.switch input {\n    display: none;\n}\n\n.slider {\n    position: absolute;\n    inset: 0;\n    background: #cbd5e1;\n    border-radius: 20px;\n    cursor: pointer;\n}\n\n.slider:before {\n    content: "";\n    position: absolute;\n    width: 19px;\n    height: 19px;\n    left: 3px;\n    top: 3px;\n    background: white;\n    border-radius: 50%;\n    transition: 0.3s;\n}\n\ninput:checked + .slider {\n    background: #2563eb;\n}\n\ninput:checked + .slider:before {\n    transform: translateX(23px);\n}\n\nfooter {\n    text-align: center;\n    padding: 25px;\n    color: #64748b;\n}\n\n@media (max-width: 800px) {\n    .grid,\n    .sensor-grid,\n    .rep-grid {\n        grid-template-columns: 1fr;\n    }\n\n    .patient-card {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n\n    .workflow {\n        flex-direction: column;\n    }\n\n    .arrow {\n        transform: rotate(90deg);\n    }\n}\n</style>\n</head>\n\n<body>\n\n<header>\n    <h1>Smart Rehabilitation Monitor</h1>\n    <p>AI-powered wearable monitoring for rehabilitation exercises</p>\n</header>\n\n<div class="container">\n\n    <div class="patient-card">\n        <div>\n            <h2>Patient 001</h2>\n            <p>Knee Rehabilitation • Exercise: Knee Flexion</p>\n        </div>\n        <div class="status">● Sensors Online</div>\n    </div>\n\n    <div class="grid">\n\n        <div class="monitor-card">\n            <h3>LIVE KNEE ANGLE</h3>\n            <div class="value" id="kneeAngle">88°</div>\n            <p>Target: 85° – 95°</p>\n        </div>\n\n        <div class="monitor-card">\n            <h3>MOVEMENT QUALITY</h3>\n            <div class="value good" id="movementQuality">GOOD</div>\n            <p>AI movement analysis</p>\n        </div>\n\n        <div class="monitor-card">\n            <h3>sEMG ACTIVITY</h3>\n            <div class="value" id="semgValue">62%</div>\n            <p>Muscle activation level</p>\n        </div>\n\n    </div>\n\n    <div class="card">\n        <div class="exercise-title">\n            <div>\n                <h2>Knee Flexion Progress</h2>\n                <p>Exercise performance</p>\n            </div>\n            <strong id="accuracy">80%</strong>\n        </div>\n\n        <div class="progress">\n            <div class="progress-bar" id="progressBar"></div>\n        </div>\n\n        <div class="rep-grid">\n            <div class="rep">\n                Total Reps\n                <strong id="totalReps">20</strong>\n            </div>\n\n            <div class="rep">\n                Correct\n                <strong id="correctReps">16</strong>\n            </div>\n\n            <div class="rep">\n                Incorrect\n                <strong id="incorrectReps">4</strong>\n            </div>\n        </div>\n    </div>\n\n    <div class="card">\n        <h2>Wearable Sensor Status</h2>\n\n        <div class="sensor-grid" style="margin-top:18px">\n\n            <div class="sensor">\n                <h3>Smart T-Shirt</h3>\n                <p>IMU + sEMG Sensors</p>\n                <p class="online">● Connected</p>\n            </div>\n\n            <div class="sensor">\n                <h3>Smart Knee Socks</h3>\n                <p>IMU Sensors</p>\n                <p class="online">● Connected</p>\n            </div>\n\n        </div>\n    </div>\n\n    <div class="card">\n        <h2>Alert Center</h2>\n        <p style="margin-top:7px">Test the rehabilitation monitoring alert.</p>\n\n        <button id="testAlert" style="margin-top:15px">\n            Test Incorrect Movement\n        </button>\n\n        <div id="alertList"></div>\n    </div>\n\n    <div class="card">\n        <h2>Notification Settings</h2>\n\n        <div class="notification-row">\n            <span>Doctor / Physiotherapist</span>\n            <label class="switch">\n                <input type="checkbox" id="doctorNotification" checked>\n                <span class="slider"></span>\n            </label>\n        </div>\n\n        <div class="notification-row">\n            <span>Caretaker</span>\n            <label class="switch">\n                <input type="checkbox" id="caretakerNotification" checked>\n                <span class="slider"></span>\n            </label>\n        </div>\n    </div>\n\n    <div class="card">\n        <h2>System Workflow</h2>\n\n        <div class="workflow">\n            <div class="step">Wearable Sensors</div>\n            <div class="arrow">→</div>\n            <div class="step">ESP32</div>\n            <div class="arrow">→</div>\n            <div class="step">AI Analysis</div>\n            <div class="arrow">→</div>\n            <div class="step">Doctor / Caretaker</div>\n        </div>\n    </div>\n\n</div>\n\n<footer>\n    Smart Rehabilitation Monitor • Prototype Dashboard\n</footer>\n\n<script>\nconst rehabData = {\n    targetMinAngle: 85,\n    targetMaxAngle: 95,\n    kneeAngle: 88,\n    semg: 62,\n    totalReps: 20,\n    correctReps: 16,\n    incorrectReps: 4\n};\n\nfunction calculateAccuracy() {\n    if (rehabData.totalReps === 0) return 0;\n    return Math.round(\n        (rehabData.correctReps / rehabData.totalReps) * 100\n    );\n}\n\nfunction getMovementQuality() {\n    const correct =\n        rehabData.kneeAngle >= rehabData.targetMinAngle &&\n        rehabData.kneeAngle <= rehabData.targetMaxAngle;\n\n    if (correct) return "GOOD";\n\n    if (\n        rehabData.kneeAngle >= rehabData.targetMinAngle - 15 &&\n        rehabData.kneeAngle <= rehabData.targetMaxAngle + 15\n    ) {\n        return "FAIR";\n    }\n\n    return "POOR";\n}\n\nfunction updateDashboard() {\n    const quality = getMovementQuality();\n\n    document.getElementById("kneeAngle").textContent =\n        rehabData.kneeAngle + "°";\n\n    const qualityElement =\n        document.getElementById("movementQuality");\n\n    qualityElement.textContent = quality;\n    qualityElement.className =\n        "value " + quality.toLowerCase();\n\n    document.getElementById("semgValue").textContent =\n        rehabData.semg + "%";\n\n    const accuracy = calculateAccuracy();\n\n    document.getElementById("accuracy").textContent =\n        accuracy + "%";\n\n    document.getElementById("progressBar").style.width =\n        accuracy + "%";\n\n    document.getElementById("totalReps").textContent =\n        rehabData.totalReps;\n\n    document.getElementById("correctReps").textContent =\n        rehabData.correctReps;\n\n    document.getElementById("incorrectReps").textContent =\n        rehabData.incorrectReps;\n}\n\nfunction createAlert(message, level) {\n    const alertList = document.getElementById("alertList");\n\n    const alert = document.createElement("div");\n\n    alert.className =\n        "alert-item " + level.toLowerCase();\n\n    alert.innerHTML = `\n        <div>\n            <strong>${level} RISK</strong>\n            <p>${message}</p>\n        </div>\n        <small>${new Date().toLocaleTimeString()}</small>\n    `;\n\n    alertList.prepend(alert);\n}\n\nfunction sendNotification(message) {\n    const doctor =\n        document.getElementById("doctorNotification").checked;\n\n    const caretaker =\n        document.getElementById("caretakerNotification").checked;\n\n    const recipients = [];\n\n    if (doctor) recipients.push("Doctor / Physiotherapist");\n    if (caretaker) recipients.push("Caretaker");\n\n    if (recipients.length > 0) {\n        console.log(\n            "Notification:",\n            recipients.join(", "),\n            message\n        );\n    }\n}\n\nfunction simulateIncorrectMovement() {\n    rehabData.kneeAngle = 55;\n    rehabData.semg = 38;\n    rehabData.incorrectReps++;\n    rehabData.totalReps++;\n\n    updateDashboard();\n\n    const message =\n        "Incorrect knee movement detected. " +\n        "Knee angle is " + rehabData.kneeAngle +\n        "°. Target range is 85°–95°.";\n\n    createAlert(message, "HIGH");\n    sendNotification(message);\n\n    setTimeout(simulateCorrectMovement, 8000);\n}\n\nfunction simulateCorrectMovement() {\n    rehabData.kneeAngle = 90;\n    rehabData.semg = 62;\n\n    updateDashboard();\n\n    createAlert(\n        "Correct knee movement detected.",\n        "LOW"\n    );\n}\n\ndocument.addEventListener("DOMContentLoaded", function() {\n    updateDashboard();\n\n    document\n        .getElementById("testAlert")\n        .addEventListener("click", simulateIncorrectMovement);\n});\n</script>\n\n</body>\n</html>\n'

output_file = Path("index.html")
output_file.write_text(website, encoding="utf-8")

print("Done!")
print("Created:", output_file.resolve())
print("Upload index.html to your GitHub repository.")
