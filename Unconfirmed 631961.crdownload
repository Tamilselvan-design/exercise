import tkinter as tk
from tkinter import ttk
from datetime import datetime


# ============================================================
# SMART REHABILITATION MONITOR
# Complete Python GUI
# ============================================================

class RehabilitationMonitor:

    def __init__(self, root):
        self.root = root
        self.root.title("Smart Rehabilitation Monitor")
        self.root.geometry("1200x800")
        self.root.minsize(950, 650)

        # -----------------------------
        # Rehabilitation data
        # -----------------------------
        self.patient_id = "Patient 001"
        self.exercise = "Knee Flexion"

        self.target_min = 85
        self.target_max = 95

        self.knee_angle = 88
        self.semg = 62

        self.total_reps = 20
        self.correct_reps = 16
        self.incorrect_reps = 4

        self.create_interface()
        self.update_dashboard()

    # ========================================================
    # MAIN INTERFACE
    # ========================================================

    def create_interface(self):

        # Main background
        self.root.configure(bg="#f4f7fb")

        # -----------------------------
        # Header
        # -----------------------------
        header = tk.Frame(
            self.root,
            bg="#12355b",
            height=90
        )
        header.pack(fill="x")

        title = tk.Label(
            header,
            text="Smart Rehabilitation Monitor",
            font=("Arial", 25, "bold"),
            bg="#12355b",
            fg="white"
        )
        title.pack(anchor="w", padx=35, pady=(18, 2))

        subtitle = tk.Label(
            header,
            text="AI-powered wearable rehabilitation monitoring system",
            font=("Arial", 11),
            bg="#12355b",
            fg="#dbeafe"
        )
        subtitle.pack(anchor="w", padx=37)

        # -----------------------------
        # Scrollable area
        # -----------------------------
        canvas = tk.Canvas(
            self.root,
            bg="#f4f7fb",
            highlightthickness=0
        )
        canvas.pack(side="left", fill="both", expand=True)

        scrollbar = ttk.Scrollbar(
            self.root,
            orient="vertical",
            command=canvas.yview
        )
        scrollbar.pack(side="right", fill="y")

        canvas.configure(yscrollcommand=scrollbar.set)

        self.main_frame = tk.Frame(
            canvas,
            bg="#f4f7fb"
        )

        canvas_window = canvas.create_window(
            (0, 0),
            window=self.main_frame,
            anchor="nw"
        )

        self.main_frame.bind(
            "<Configure>",
            lambda event: canvas.configure(
                scrollregion=canvas.bbox("all")
            )
        )

        canvas.bind(
            "<Configure>",
            lambda event: canvas.itemconfig(
                canvas_window,
                width=event.width
            )
        )

        # -----------------------------
        # Patient information
        # -----------------------------
        self.create_patient_card()

        # -----------------------------
        # Live monitoring
        # -----------------------------
        self.create_live_monitoring()

        # -----------------------------
        # Exercise progress
        # -----------------------------
        self.create_exercise_progress()

        # -----------------------------
        # Wearable sensors
        # -----------------------------
        self.create_sensor_section()

        # -----------------------------
        # Alert center
        # -----------------------------
        self.create_alert_section()

        # -----------------------------
        # Notification settings
        # -----------------------------
        self.create_notification_section()

        # -----------------------------
        # Workflow
        # -----------------------------
        self.create_workflow()

        # -----------------------------
        # Footer
        # -----------------------------
        footer = tk.Label(
            self.main_frame,
            text="Smart Rehabilitation Monitor • Prototype",
            font=("Arial", 10),
            bg="#f4f7fb",
            fg="#64748b"
        )
        footer.pack(pady=25)

    # ========================================================
    # PATIENT CARD
    # ========================================================

    def create_patient_card(self):

        card = tk.Frame(
            self.main_frame,
            bg="white",
            bd=0,
            highlightbackground="#e5e7eb",
            highlightthickness=1
        )
        card.pack(
            fill="x",
            padx=30,
            pady=20
        )

        left = tk.Frame(card, bg="white")
        left.pack(side="left", padx=25, pady=18)

        tk.Label(
            left,
            text=self.patient_id,
            font=("Arial", 20, "bold"),
            bg="white",
            fg="#1f2937"
        ).pack(anchor="w")

        tk.Label(
            left,
            text="Knee Rehabilitation  •  Exercise: Knee Flexion",
            font=("Arial", 11),
            bg="white",
            fg="#64748b"
        ).pack(anchor="w", pady=5)

        self.sensor_status = tk.Label(
            card,
            text="●  SENSORS ONLINE",
            font=("Arial", 11, "bold"),
            bg="#dcfce7",
            fg="#15803d",
            padx=15,
            pady=8
        )
        self.sensor_status.pack(
            side="right",
            padx=25
        )

    # ========================================================
    # LIVE MONITORING
    # ========================================================

    def create_live_monitoring(self):

        title = tk.Label(
            self.main_frame,
            text="Live Monitoring",
            font=("Arial", 19, "bold"),
            bg="#f4f7fb",
            fg="#1f2937"
        )
        title.pack(anchor="w", padx=30, pady=(5, 15))

        container = tk.Frame(
            self.main_frame,
            bg="#f4f7fb"
        )
        container.pack(
            fill="x",
            padx=30
        )

        # Knee angle
        self.knee_card = self.create_monitor_card(
            container,
            "LIVE KNEE ANGLE",
            "88°",
            "Target: 85° – 95°"
        )

        # Movement quality
        self.quality_card = self.create_monitor_card(
            container,
            "MOVEMENT QUALITY",
            "GOOD",
            "AI movement analysis"
        )

        # sEMG
        self.semg_card = self.create_monitor_card(
            container,
            "sEMG ACTIVITY",
            "62%",
            "Muscle activation level"
        )

        self.knee_card.pack(
            side="left",
            fill="both",
            expand=True,
            padx=(0, 8)
        )

        self.quality_card.pack(
            side="left",
            fill="both",
            expand=True,
            padx=8
        )

        self.semg_card.pack(
            side="left",
            fill="both",
            expand=True,
            padx=(8, 0)
        )

    def create_monitor_card(
        self,
        parent,
        heading,
        value,
        description
    ):

        card = tk.Frame(
            parent,
            bg="white",
            highlightbackground="#e5e7eb",
            highlightthickness=1
        )

        tk.Label(
            card,
            text=heading,
            font=("Arial", 10, "bold"),
            bg="white",
            fg="#64748b"
        ).pack(
            anchor="w",
            padx=20,
            pady=(18, 5)
        )

        value_label = tk.Label(
            card,
            text=value,
            font=("Arial", 27, "bold"),
            bg="white",
            fg="#1f2937"
        )
        value_label.pack(
            anchor="w",
            padx=20
        )

        tk.Label(
            card,
            text=description,
            font=("Arial", 10),
            bg="white",
            fg="#64748b"
        ).pack(
            anchor="w",
            padx=20,
            pady=(5, 18)
        )

        card.value_label = value_label

        return card

    # ========================================================
    # EXERCISE PROGRESS
    # ========================================================

    def create_exercise_progress(self):

        card = tk.Frame(
            self.main_frame,
            bg="white",
            highlightbackground="#e5e7eb",
            highlightthickness=1
        )
        card.pack(
            fill="x",
            padx=30,
            pady=20
        )

        top = tk.Frame(card, bg="white")
        top.pack(
            fill="x",
            padx=25,
            pady=(20, 10)
        )

        tk.Label(
            top,
            text="Knee Flexion Progress",
            font=("Arial", 18, "bold"),
            bg="white",
            fg="#1f2937"
        ).pack(side="left")

        self.accuracy_label = tk.Label(
            top,
            text="80%",
            font=("Arial", 20, "bold"),
            bg="white",
            fg="#2563eb"
        )
        self.accuracy_label.pack(side="right")

        tk.Label(
            card,
            text="Exercise performance",
            font=("Arial", 10),
            bg="white",
            fg="#64748b"
        ).pack(
            anchor="w",
            padx=25
        )

        # Progress bar
        self.progress = ttk.Progressbar(
            card,
            orient="horizontal",
            length=500,
            mode="determinate"
        )
        self.progress.pack(
            fill="x",
            padx=25,
            pady=20
        )

        # Rep cards
        reps = tk.Frame(
            card,
            bg="white"
        )
        reps.pack(
            fill="x",
            padx=25,
            pady=(0, 20)
        )

        self.total_label = self.create_rep_card(
            reps,
            "TOTAL REPS",
            "20"
        )

        self.correct_label = self.create_rep_card(
            reps,
            "CORRECT",
            "16"
        )

        self.incorrect_label = self.create_rep_card(
            reps,
            "INCORRECT",
            "4"
        )

    def create_rep_card(
        self,
        parent,
        title,
        value
    ):

        frame = tk.Frame(
            parent,
            bg="#f8fafc",
            highlightbackground="#e5e7eb",
            highlightthickness=1
        )

        frame.pack(
            side="left",
            fill="both",
            expand=True,
            padx=5
        )

        tk.Label(
            frame,
            text=title,
            font=("Arial", 9, "bold"),
            bg="#f8fafc",
            fg="#64748b"
        ).pack(pady=(12, 3))

        value_label = tk.Label(
            frame,
            text=value,
            font=("Arial", 22, "bold"),
            bg="#f8fafc",
            fg="#1f2937"
        )

        value_label.pack(pady=(0, 12))

        return value_label

    # ========================================================
    # SENSOR SECTION
    # ========================================================

    def create_sensor_section(self):

        card = tk.Frame(
            self.main_frame,
            bg="white",
            highlightbackground="#e5e7eb",
            highlightthickness=1
        )
        card.pack(
            fill="x",
            padx=30,
            pady=(0, 20)
        )

        tk.Label(
            card,
            text="Wearable Sensor Status",
            font=("Arial", 18, "bold"),
            bg="white",
            fg="#1f2937"
        ).pack(
            anchor="w",
            padx=25,
            pady=(20, 15)
        )

        sensors = tk.Frame(
            card,
            bg="white"
        )
        sensors.pack(
            fill="x",
            padx=25,
            pady=(0, 20)
        )

        self.create_sensor_card(
            sensors,
            "SMART T-SHIRT",
            "IMU + sEMG Sensors"
        )

        self.create_sensor_card(
            sensors,
            "SMART KNEE SOCKS",
            "IMU Sensors"
        )

    def create_sensor_card(
        self,
        parent,
        title,
        description
    ):

        sensor = tk.Frame(
            parent,
            bg="#f8fafc",
            highlightbackground="#e5e7eb",
            highlightthickness=1
        )

        sensor.pack(
            side="left",
            fill="both",
            expand=True,
            padx=5
        )

        tk.Label(
            sensor,
            text=title,
            font=("Arial", 12, "bold"),
            bg="#f8fafc",
            fg="#1f2937"
        ).pack(
            anchor="w",
            padx=15,
            pady=(15, 5)
        )

        tk.Label(
            sensor,
            text=description,
            font=("Arial", 10),
            bg="#f8fafc",
            fg="#64748b"
        ).pack(
            anchor="w",
            padx=15
        )

        tk.Label(
            sensor,
            text="● Connected",
            font=("Arial", 10, "bold"),
            bg="#f8fafc",
            fg="#16a34a"
        ).pack(
            anchor="w",
            padx=15,
            pady=(8, 15)
        )

    # ========================================================
    # ALERT CENTER
    # ========================================================

    def create_alert_section(self):

        card = tk.Frame(
            self.main_frame,
            bg="white",
            highlightbackground="#e5e7eb",
            highlightthickness=1
        )
        card.pack(
            fill="x",
            padx=30,
            pady=(0, 20)
        )

        title_frame = tk.Frame(
            card,
            bg="white"
        )
        title_frame.pack(
            fill="x",
            padx=25,
            pady=(20, 5)
        )

        tk.Label(
            title_frame,
            text="Alert Center",
            font=("Arial", 18, "bold"),
            bg="white",
            fg="#1f2937"
        ).pack(side="left")

        self.alert_button = tk.Button(
            title_frame,
            text="TEST INCORRECT MOVEMENT",
            command=self.simulate_incorrect_movement,
            bg="#dc2626",
            fg="white",
            activebackground="#b91c1c",
            activeforeground="white",
            relief="flat",
            padx=15,
            pady=9,
            cursor="hand2"
        )
        self.alert_button.pack(side="right")

        tk.Label(
            card,
            text="AI detects abnormal rehabilitation movement and generates an alert.",
            font=("Arial", 10),
            bg="white",
            fg="#64748b"
        ).pack(
            anchor="w",
            padx=25,
            pady=(0, 12)
        )

        self.alert_list = tk.Frame(
            card,
            bg="white"
        )
        self.alert_list.pack(
            fill="x",
            padx=25,
            pady=(0, 20)
        )

    def create_alert(
        self,
        message,
        level="HIGH"
    ):

        alert_bg = "#fee2e2"
        alert_fg = "#dc2626"

        if level == "LOW":
            alert_bg = "#dcfce7"
            alert_fg = "#15803d"

        alert = tk.Frame(
            self.alert_list,
            bg=alert_bg
        )
        alert.pack(
            fill="x",
            pady=5
        )

        left = tk.Frame(
            alert,
            bg=alert_bg
        )
        left.pack(
            side="left",
            padx=15,
            pady=12
        )

        tk.Label(
            left,
            text=f"{level} RISK",
            font=("Arial", 10, "bold"),
            bg=alert_bg,
            fg=alert_fg
        ).pack(anchor="w")

        tk.Label(
            left,
            text=message,
            font=("Arial", 10),
            bg=alert_bg,
            fg="#374151",
            wraplength=800,
            justify="left"
        ).pack(anchor="w", pady=3)

        tk.Label(
            alert,
            text=datetime.now().strftime("%H:%M:%S"),
            font=("Arial", 9),
            bg=alert_bg,
            fg="#64748b"
        ).pack(
            side="right",
            padx=15
        )

    # ========================================================
    # NOTIFICATION SETTINGS
    # ========================================================

    def create_notification_section(self):

        card = tk.Frame(
            self.main_frame,
            bg="white",
            highlightbackground="#e5e7eb",
            highlightthickness=1
        )

        card.pack(
            fill="x",
            padx=30,
            pady=(0, 20)
        )

        tk.Label(
            card,
            text="Notification Settings",
            font=("Arial", 18, "bold"),
            bg="white",
            fg="#1f2937"
        ).pack(
            anchor="w",
            padx=25,
            pady=(20, 10)
        )

        self.doctor_notification = tk.BooleanVar(value=True)
        self.caretaker_notification = tk.BooleanVar(value=True)

        self.create_notification_row(
            card,
            "Doctor / Physiotherapist",
            self.doctor_notification
        )

        self.create_notification_row(
            card,
            "Caretaker",
            self.caretaker_notification
        )

    def create_notification_row(
        self,
        parent,
        text,
        variable
    ):

        row = tk.Frame(
            parent,
            bg="white"
        )

        row.pack(
            fill="x",
            padx=25,
            pady=8
        )

        tk.Label(
            row,
            text=text,
            font=("Arial", 11),
            bg="white",
            fg="#374151"
        ).pack(side="left")

        tk.Checkbutton(
            row,
            variable=variable,
            bg="white",
            activebackground="white"
        ).pack(side="right")

    # ========================================================
    # WORKFLOW
    # ========================================================

    def create_workflow(self):

        card = tk.Frame(
            self.main_frame,
            bg="white",
            highlightbackground="#e5e7eb",
            highlightthickness=1
        )

        card.pack(
            fill="x",
            padx=30,
            pady=(0, 20)
        )

        tk.Label(
            card,
            text="System Workflow",
            font=("Arial", 18, "bold"),
            bg="white",
            fg="#1f2937"
        ).pack(
            anchor="w",
            padx=25,
            pady=(20, 15)
        )

        workflow = tk.Frame(
            card,
            bg="white"
        )
        workflow.pack(
            fill="x",
            padx=25,
            pady=(0, 25)
        )

        steps = [
            "WEARABLE\nSENSORS",
            "ESP32",
            "AI\nANALYSIS",
            "DOCTOR /\nCARETAKER"
        ]

        for i, step in enumerate(steps):

            box = tk.Label(
                workflow,
                text=step,
                font=("Arial", 11, "bold"),
                bg="#eff6ff",
                fg="#1e40af",
                width=17,
                height=3
            )

            box.pack(
                side="left",
                fill="x",
                expand=True
            )

            if i < len(steps) - 1:

                tk.Label(
                    workflow,
                    text="→",
                    font=("Arial", 22, "bold"),
                    bg="white",
                    fg="#64748b"
                ).pack(
                    side="left",
                    padx=8
                )

    # ========================================================
    # DASHBOARD UPDATE
    # ========================================================

    def update_dashboard(self):

        accuracy = 0

        if self.total_reps > 0:
            accuracy = round(
                (self.correct_reps / self.total_reps) * 100
            )

        # Knee angle
        self.knee_card.value_label.config(
            text=f"{self.knee_angle}°"
        )

        # Movement quality
        if (
            self.target_min
            <= self.knee_angle
            <= self.target_max
        ):
            quality = "GOOD"
            quality_color = "#16a34a"

        elif (
            self.target_min - 15
            <= self.knee_angle
            <= self.target_max + 15
        ):
            quality = "FAIR"
            quality_color = "#d97706"

        else:
            quality = "POOR"
            quality_color = "#dc2626"

        self.quality_card.value_label.config(
            text=quality,
            fg=quality_color
        )

        # sEMG
        self.semg_card.value_label.config(
            text=f"{self.semg}%"
        )

        # Accuracy
        self.accuracy_label.config(
            text=f"{accuracy}%"
        )

        self.progress["value"] = accuracy

        # Repetitions
        self.total_label.config(
            text=str(self.total_reps)
        )

        self.correct_label.config(
            text=str(self.correct_reps)
        )

        self.incorrect_label.config(
            text=str(self.incorrect_reps)
        )

    # ========================================================
    # INCORRECT MOVEMENT
    # ========================================================

    def simulate_incorrect_movement(self):

        # Simulated abnormal sensor values
        self.knee_angle = 55
        self.semg = 38

        self.incorrect_reps += 1
        self.total_reps += 1

        self.update_dashboard()

        message = (
            f"Incorrect knee movement detected. "
            f"Knee angle: {self.knee_angle}°. "
            f"Target range: {self.target_min}°–{self.target_max}°."
        )

        self.create_alert(
            message,
            "HIGH"
        )

        self.send_notification(message)

        # Automatically return to normal after 5 seconds
        self.root.after(
            5000,
            self.simulate_correct_movement
        )

    # ========================================================
    # CORRECT MOVEMENT
    # ========================================================

    def simulate_correct_movement(self):

        self.knee_angle = 90
        self.semg = 62

        self.update_dashboard()

        self.create_alert(
            "Correct knee movement detected.",
            "LOW"
        )

    # ========================================================
    # NOTIFICATION
    # ========================================================

    def send_notification(self, message):

        recipients = []

        if self.doctor_notification.get():
            recipients.append("Doctor / Physiotherapist")

        if self.caretaker_notification.get():
            recipients.append("Caretaker")

        if recipients:

            print("\n--------------------------------")
            print("REHABILITATION ALERT")
            print("--------------------------------")
            print("Message:", message)
            print("Sent to:", ", ".join(recipients))
            print("--------------------------------\n")


# ============================================================
# START APPLICATION
# ============================================================

if __name__ == "__main__":

    root = tk.Tk()

    app = RehabilitationMonitor(root)

    root.mainloop()
